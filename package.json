{
  "name": "civicfix-ai",
  "version": "1.0.0",
  "description": "SpotFix AI - MERN based civic complaint management system",
  "main": "index.js",
  "scripts": {
    "install-all": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm install --prefix backend && npm install --include=dev --prefix frontend && npm run build --prefix frontend",
    "start": "npm start --prefix backend"
  },
  "engines": {
    "node": "22.x"
  },
  "keywords": [
    "mern",
    "civicfix",
    "smart-city",
    "ai-assisted",
    "complaint-management"
  ],
  "author": "Lithilya",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
